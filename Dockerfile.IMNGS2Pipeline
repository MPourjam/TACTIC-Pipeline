FROM python:3.11.0-slim-bullseye

# Setting some environment variables
# Install locales package
# Install dependencies
RUN apt update -y && apt upgrade -y
RUN apt update --fix-missing
RUN apt install -y libharfbuzz-dev libfribidi-dev cmake
RUN apt install -y vim rsync wget
RUN apt install -y fastqc
RUN apt install -y graphlan gfortran
RUN apt-get update && apt-get install -y locales
RUN apt update -y && apt upgrade -y
RUN apt-get update --fix-missing
# Generate the locale

RUN touch /etc/locale.gen
RUN sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen && \
    locale-gen
ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8


#########################
# Downloading Databases #
#########################
RUN mkdir -p /base/binaries
RUN mkdir -p /base/databases
COPY binaries/ /base/binaries/
COPY databases/ /base/databases/
RUN /bin/bash /base/databases/SILVA_download.sh

###########################
# Copying necessary files #
###########################
RUN mkdir -p /base
RUN mkdir -p /base/spikesidx
RUN mkdir -p /base/imngs2_pipeline
COPY spikesidx/ /base/spikesidx/
COPY imngs2_pipeline /base/imngs2_pipeline/
COPY run_imngs2.py /base/run_imngs2.py
COPY IMNGS2Pipeline_args.yml /base/IMNGS2Pipeline_args.yml
COPY mapping_file_TEMPLATE.csv /base/mapping_file_TEMPLATE.csv
COPY requirements.txt /base/requirements.txt


######################
## PIP DEPENDENCIES ##
######################
RUN pip install --upgrade pip
RUN pip install --upgrade -r /base/requirements.txt


